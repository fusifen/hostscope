---
export interface Props {
  pros: string[];
  cons: string[];
  prosTitle?: string;
  consTitle?: string;
  class?: string;
}

const {
  pros,
  cons,
  prosTitle = 'What we liked',
  consTitle = 'What to watch out for',
  class: className = '',
} = Astro.props;
---

<div class={`grid gap-4 sm:grid-cols-2 ${className}`}>
  <div class="rounded-2xl border border-mint-200 bg-mint-50/60 p-5">
    <h3 class="flex items-center gap-2 text-[0.9375rem] font-bold !text-mint-900">
      <span
        class="flex h-6 w-6 items-center justify-center rounded-full bg-mint-500 text-white"
        aria-hidden="true"
      >
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" class="h-3.5 w-3.5">
          <path d="m3.5 8.5 3 3 6-7" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </span>
      {prosTitle}
    </h3>
    <ul class="mt-3.5 space-y-2.5">
      {
        pros.map((item) => (
          <li class="flex gap-2.5 text-[0.875rem] leading-relaxed text-ink-700">
            <span class="mt-[0.45rem] h-1.5 w-1.5 shrink-0 rounded-full bg-mint-500" aria-hidden="true" />
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="rounded-2xl border border-coral-100 bg-coral-50/60 p-5">
    <h3 class="flex items-center gap-2 text-[0.9375rem] font-bold !text-coral-600">
      <span
        class="flex h-6 w-6 items-center justify-center rounded-full bg-coral-500 text-white"
        aria-hidden="true"
      >
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" class="h-3.5 w-3.5">
          <path d="M8 4v5M8 12h.01" stroke-linecap="round"></path>
        </svg>
      </span>
      {consTitle}
    </h3>
    <ul class="mt-3.5 space-y-2.5">
      {
        cons.map((item) => (
          <li class="flex gap-2.5 text-[0.875rem] leading-relaxed text-ink-700">
            <span class="mt-[0.45rem] h-1.5 w-1.5 shrink-0 rounded-full bg-coral-500" aria-hidden="true" />
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
</div>
