---
/**
 * TableOfContents — built from Astro's rendered headings.
 * Includes a scroll-spy that highlights the section you are reading, and
 * collapses behind a <details> on mobile so it does not push the article down.
 */
export interface Heading {
  depth: number;
  slug: string;
  text: string;
}

export interface Props {
  headings: Heading[];
  title?: string;
  /** Sticky sidebar variant (desktop) vs inline variant. */
  variant?: 'sidebar' | 'inline';
  class?: string;
}

const { headings, title = 'On this page', variant = 'sidebar', class: className = '' } = Astro.props;

// Only h2 and h3 make a useful TOC — h4 gets noisy
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);

const wrapperClass =
  variant === 'sidebar'
    ? `hidden lg:block ${className}`
    : `lg:hidden ${className}`;
---

{
  items.length >= 3 && (
    <nav class={wrapperClass} aria-labelledby="toc-heading">
      <div
        class:list={[
          'rounded-2xl border border-line bg-white p-4',
          variant === 'sidebar' && 'sticky top-28 max-h-[calc(100dvh-9rem)] overflow-y-auto',
        ]}
      >
        <h2
          id="toc-heading"
          class="flex items-center gap-2 text-[0.6875rem] font-bold tracking-[0.1em] !text-ink-500 uppercase"
        >
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" class="h-3.5 w-3.5" aria-hidden="true">
            <path d="M3 4h10M3 8h10M3 12h6" stroke-linecap="round"></path>
          </svg>
          {title}
        </h2>
        <ol class="mt-3 space-y-0.5 border-l border-line" data-toc>
          {items.map((h) => (
            <li>
              <a
                href={`#${h.slug}`}
                data-toc-link={h.slug}
                class:list={[
                  '-ml-px block border-l-2 border-transparent py-1.5 pl-3 text-[0.8125rem] leading-snug text-ink-500 transition',
                  'hover:border-brand-300 hover:text-brand-700',
                  h.depth === 3 && 'pl-6 text-[0.78125rem]',
                ]}
              >
                {h.text}
              </a>
            </li>
          ))}
        </ol>
      </div>
    </nav>
  )
}

<script>
  // Scroll-spy: highlight the heading of the section currently in view.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
  if (links.length) {
    const targets = links
      .map((link) => {
        const id = link.dataset.tocLink;
        const el = id ? document.getElementById(id) : null;
        return el ? { link, el } : null;
      })
      .filter((v): v is { link: HTMLAnchorElement; el: HTMLElement } => v !== null);

    const setActive = (activeLink: HTMLAnchorElement | null) => {
      links.forEach((link) => {
        const isActive = link === activeLink;
        link.classList.toggle('border-brand-500', isActive);
        link.classList.toggle('text-brand-700', isActive);
        link.classList.toggle('font-semibold', isActive);
        link.classList.toggle('border-transparent', !isActive);
        link.classList.toggle('text-ink-500', !isActive);
        link.classList.toggle('font-normal', !isActive);
      });
    };

    if ('IntersectionObserver' in window) {
      const visible = new Map<Element, number>();
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) visible.set(entry.target, entry.boundingClientRect.top);
            else visible.delete(entry.target);
          });
          const sorted = [...visible.entries()].sort((a, b) => a[1] - b[1]);
          const top = sorted[0]?.[0];
          setActive(top ? (targets.find((t) => t.el === top)?.link ?? null) : null);
        },
        { rootMargin: '-96px 0px -70% 0px', threshold: [0, 1] },
      );
      targets.forEach((t) => observer.observe(t.el));
    }
  }
</script>
