---
import { FOOTER_NAV, SITE, AFFILIATE, affiliateUrl } from '../consts';
import Logo from './Logo.astro';
import AffiliateButton from './AffiliateButton.astro';

const year = new Date().getFullYear();
const disclosureUrl = affiliateUrl({ placement: 'footer-cta', campaign: 'footer' });
---

<footer class="mt-16 border-t border-ink-800 bg-ink-950 text-ink-300">
  <!-- Conversion band -->
  <div class="border-b border-white/10">
    <div class="container-page grid gap-8 py-12 lg:grid-cols-[1.2fr_auto] lg:items-center">
      <div>
        <p class="eyebrow !text-brand-300">Ready to launch?</p>
        <h2 class="mt-3 max-w-xl text-2xl font-extrabold !text-white sm:text-3xl">
          Start on Hostinger for $2.99/mo — free domain, free SSL, 30-day money-back guarantee.
        </h2>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink-300">
          The 48-month term is where the discount lives. If you'd rather not commit, the same plans
          are available monthly — you'll just pay closer to the regular rate. Either way you're
          covered by Hostinger's 30-day refund window.
        </p>
      </div>
      <div class="flex flex-col items-start gap-3 lg:items-end">
        <AffiliateButton
          placement="footer-cta"
          campaign="site-footer"
          label="Claim the deal"
          size="xl"
          variant="mint"
          class="!bg-none !bg-mint-500 hover:!bg-mint-600"
        />
        <p class="text-[0.6875rem] text-ink-400 lg:text-right">
          Affiliate link · we may earn a commission at no extra cost to you.
        </p>
      </div>
    </div>
  </div>

  <!-- Link columns -->
  <div class="container-page py-12">
    <div class="grid gap-10 lg:grid-cols-[1.1fr_3fr]">
      <div>
        <Logo variant="light" />
        <p class="mt-4 max-w-xs text-[0.8125rem] leading-relaxed text-ink-400">
          {SITE.description}
        </p>
        <dl class="mt-5 space-y-2 text-[0.75rem] text-ink-400">
          <div class="flex gap-2">
            <dt class="font-semibold text-ink-300">Prices verified:</dt>
            <dd>{SITE.pricingVerified}</dd>
          </div>
          <div class="flex gap-2">
            <dt class="font-semibold text-ink-300">Affiliate ID:</dt>
            <dd>{AFFILIATE.affId}</dd>
          </div>
        </dl>
      </div>

      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
        {
          FOOTER_NAV.map((column) => (
            <nav aria-label={column.title}>
              <h3 class="text-[0.6875rem] font-bold tracking-[0.12em] !text-white uppercase">
                {column.title}
              </h3>
              <ul class="mt-3 space-y-2">
                {column.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="text-[0.8125rem] text-ink-400 transition hover:text-white"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Legal -->
  <div class="border-t border-white/10">
    <div class="container-page flex flex-col gap-4 py-6 text-[0.75rem] text-ink-400 md:flex-row md:items-center md:justify-between">
      <p>
        © {year} {SITE.publisher.legalName}. All rights reserved. {SITE.name} is an independent
        publication and is not affiliated with, endorsed by, or operated by Hostinger
        International Ltd.
      </p>
      <p class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <a href="/privacy/" class="transition hover:text-white">Privacy</a>
        <a href="/terms/" class="transition hover:text-white">Terms</a>
        <a href="/affiliate-disclosure/" class="transition hover:text-white">Disclosure</a>
        <a href="/contact/" class="transition hover:text-white">Contact</a>
        <a href={disclosureUrl} rel="sponsored nofollow noopener" target="_blank" class="transition hover:text-white">
          Hostinger.com
        </a>
      </p>
    </div>
  </div>
</footer>
