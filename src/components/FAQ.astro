---
/**
 * FAQ — accessible accordion that renders FAQ content.
 * Pass the same array to `faqSchema()` and feed it to the layout so the page
 * emits valid FAQPage structured data alongside the visible markup.
 */
export interface Props {
  faqs: { question: string; answer: string }[];
  title?: string;
  class?: string;
  /** Open the first item by default. */
  openFirst?: boolean;
}

const {
  faqs,
  title = 'Frequently asked questions',
  class: className = '',
  openFirst = false,
} = Astro.props;
---

{
  faqs.length > 0 && (
    <section class={`not-prose ${className}`} aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="text-xl font-extrabold tracking-[-0.02em] text-ink-950 sm:text-2xl">
        {title}
      </h2>
      <div class="mt-5 divide-y divide-line overflow-hidden rounded-2xl border border-line bg-white">
        {faqs.map((faq, i) => (
          <details class="group" open={openFirst && i === 0}>
            <summary class="flex cursor-pointer list-none items-start justify-between gap-4 px-5 py-4 marker:hidden hover:bg-ink-50">
              <span class="text-[0.9375rem] font-semibold leading-snug text-ink-900">
                {faq.question}
              </span>
              <span
                class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-ink-100 text-ink-600 transition group-open:rotate-45 group-open:bg-brand-100 group-open:text-brand-700"
                aria-hidden="true"
              >
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" class="h-3.5 w-3.5">
                  <path d="M8 3v10M3 8h10" stroke-linecap="round"></path>
                </svg>
              </span>
            </summary>
            <div class="px-5 pb-5 pr-14 text-[0.9375rem] leading-relaxed text-ink-600">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </section>
  )
}
