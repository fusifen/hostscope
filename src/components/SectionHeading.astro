---
export interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  /** Heading level — keep the document outline sensible. */
  as?: 'h1' | 'h2' | 'h3';
  class?: string;
  /** Renders the heading in white for dark sections. */
  light?: boolean;
}

const {
  eyebrow,
  title,
  description,
  align = 'left',
  as = 'h2',
  class: className = '',
  light = false,
} = Astro.props;

const Tag = as;
const alignClass = align === 'center' ? 'text-center mx-auto items-center' : 'text-left items-start';
const titleSize =
  as === 'h1' ? 'text-3xl sm:text-4xl lg:text-[2.75rem]' : 'text-2xl sm:text-3xl lg:text-[2.125rem]';
---

<div class={`flex max-w-3xl flex-col ${alignClass} ${className}`}>
  {
    eyebrow && (
      <p class:list={['eyebrow', light && '!text-brand-300']}>
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-current" />
        {eyebrow}
      </p>
    )
  }
  <Tag
    class:list={[
      'mt-3 font-extrabold leading-[1.15] tracking-[-0.028em]',
      titleSize,
      light && '!text-white',
    ]}
  >
    {title}
  </Tag>
  {
    description && (
      <p
        class:list={[
          'mt-4 text-[1.0625rem] leading-relaxed',
          light ? 'text-ink-300' : 'text-ink-600',
        ]}
      >
        {description}
      </p>
    )
  }
  <slot />
</div>
