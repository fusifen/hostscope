---
/**
 * BaseHead — everything that belongs inside <head>.
 * Handles titles, canonicals, robots directives, Open Graph, Twitter cards,
 * RSS discovery, font loading and JSON-LD structured data.
 */
import { SITE } from '../consts';

export interface Props {
  title: string;
  description: string;
  /** Absolute or root-relative image path used for OG/Twitter cards. */
  image?: string;
  /** Full canonical URL. Defaults to the current page URL. */
  canonical?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** Pre-built JSON-LD document (see src/lib/seo.ts). */
  schema?: object | object[];
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  keywords?: string[];
}

const {
  title,
  description,
  image = SITE.defaultOgImage,
  canonical,
  type = 'website',
  noindex = false,
  schema,
  publishedTime,
  modifiedTime,
  author,
  keywords = [],
} = Astro.props;

const siteUrl = Astro.site ?? new URL(SITE.url);
const canonicalUrl = canonical
  ? canonical.startsWith('http')
    ? canonical
    : new URL(canonical, siteUrl).toString()
  : new URL(Astro.url.pathname.replace(/\/+$/, '') || '/', siteUrl).toString();

const ogImage = image.startsWith('http') ? image : new URL(image, siteUrl).toString();
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;

const schemaNodes = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

{
  noindex ? (
    <meta name="robots" content="noindex, nofollow, noarchive" />
  ) : (
    <>
      <meta
        name="robots"
        content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
      />
      <meta name="googlebot" content="index, follow" />
    </>
  )
}

{keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:locale" content={SITE.locale} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
{author && <meta property="article:author" content={author} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:site" content="@hostscope" />

<!-- Icons & PWA-ish niceties -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="apple-touch-icon" href="/images/brand/apple-touch-icon.png" />
<meta name="theme-color" content="#673de6" />
<meta name="color-scheme" content="light" />
<meta name="format-detection" content="telephone=no" />

<!-- Discovery -->
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE.name} — latest articles`}
  href={new URL('/rss.xml', siteUrl).toString()}
/>
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

<!-- Fonts: preconnect early, load Inter, fall back to the system stack -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap"
/>

<!-- Structured data -->
{
  schemaNodes.length > 0 && (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(
        schemaNodes.length === 1
          ? { '@context': 'https://schema.org', ...schemaNodes[0] }
          : { '@context': 'https://schema.org', '@graph': schemaNodes },
      )}
    />
  )
}

<!-- Mark no-JS so the reveal animations degrade to "always visible" -->
<script is:inline>
  (function () {
    var root = document.documentElement;
    root.classList.remove('no-js');
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      root.classList.add('reduced-motion');
    }
  })();
</script>
