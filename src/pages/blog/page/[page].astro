---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ArticleListing from '../../../components/ArticleListing.astro';
import { SITE } from '../../../consts';
import { breadcrumbSchema, graph, organizationSchema } from '../../../lib/seo';

export async function getStaticPaths() {
  const PAGE_SIZE = 9;
  const allArticles = (await getCollection('articles')).filter((a) => !a.data.draft);
  const totalPages = Math.max(1, Math.ceil(allArticles.length / PAGE_SIZE));

  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => {
    const page = i + 2;
    return {
      params: { page: String(page) },
      props: {
        page,
        totalPages,
        totalCount: allArticles.length,
        articles: allArticles
          .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
          .slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE),
      },
    };
  });
}

const { page, totalPages, totalCount, articles } = Astro.props;

const allArticles = (await getCollection('articles')).filter((a) => !a.data.draft);

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Articles', href: '/blog/' },
  { name: `Page ${page}`, href: `/blog/page/${page}/` },
];

const schema = graph([organizationSchema(), breadcrumbSchema(breadcrumbs)]);
---

<BaseLayout
  title={`Hostinger Articles — Page ${page} of ${totalPages}`}
  description={`Page ${page} of our Hostinger article archive: independent reviews, buying guides, tutorials and troubleshooting for every Hostinger plan.`}
  canonical={`${SITE.url}/blog/page/${page}/`}
  schema={schema}
  noindex={false}
>
  <header class="border-b border-line bg-white">
    <div class="container-page py-8 lg:py-10">
      <Breadcrumbs items={breadcrumbs} />
      <div class="mt-5 max-w-3xl">
        <p class="eyebrow">Archive · page {page} of {totalPages}</p>
        <h1 class="mt-3 text-[1.75rem] font-extrabold leading-[1.14] tracking-[-0.03em] sm:text-[2.25rem]">
          All Hostinger articles
        </h1>
      </div>
    </div>
  </header>

  <div class="container-page py-10 lg:py-12">
    <ArticleListing
      articles={articles}
      allArticles={allArticles}
      currentPage={page}
      totalPages={totalPages}
      totalCount={totalCount}
    />
  </div>
</BaseLayout>
