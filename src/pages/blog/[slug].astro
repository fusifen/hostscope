---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles
    .filter((a) => !a.data.draft)
    .map((article) => ({
      params: { slug: article.id },
      props: { article },
    }));
}

const { article } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(article);

const allArticles = (await getCollection('articles')).filter((a) => !a.data.draft);
const plans = await getCollection('plans');

/* Pick the plan this article should push:
   1. the first entry in relatedPlans, if it resolves
   2. otherwise the plan matching the article category's usual intent      */
const primaryPlan =
  article.data.relatedPlans
    .map((slug) => plans.find((p) => p.id === slug))
    .find((p): p is NonNullable<typeof p> => Boolean(p)) ??
  plans.find((p) => p.id === 'unlimited');

/* Related reading: explicit slugs first, then same-category fill           */
const explicit = article.data.relatedArticles
  .map((slug) => allArticles.find((a) => a.id === slug))
  .filter((a): a is NonNullable<typeof a> => Boolean(a) && a!.id !== article.id);

const fill = allArticles
  .filter(
    (a) =>
      a.id !== article.id &&
      a.data.category === article.data.category &&
      !explicit.some((e) => e.id === a.id),
  )
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const related = [...explicit, ...fill].slice(0, 4);

const wordCount =
  typeof remarkPluginFrontmatter?.wordCount === 'number'
    ? remarkPluginFrontmatter.wordCount
    : undefined;
---

<ArticleLayout
  article={article}
  headings={headings}
  primaryPlan={primaryPlan}
  related={related}
  wordCount={wordCount}
>
  <Content />
</ArticleLayout>
