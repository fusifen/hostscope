---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleListing from '../../components/ArticleListing.astro';
import { SITE, CATEGORY_LIST, resolveEditor } from '../../consts';
import { breadcrumbSchema, graph, organizationSchema } from '../../lib/seo';

const PAGE_SIZE = 9;

const allArticles = (await getCollection('articles'))
  .filter((a) => !a.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const totalPages = Math.max(1, Math.ceil(allArticles.length / PAGE_SIZE));
const articles = allArticles.slice(0, PAGE_SIZE);

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Articles', href: '/blog/' },
];

const schema = graph([
  organizationSchema(),
  breadcrumbSchema(breadcrumbs),
  {
    '@type': 'CollectionPage',
    name: 'Hostinger articles, reviews and tutorials',
    description:
      'Every Hostinger review, buying guide, tutorial, deal and troubleshooting article we have published.',
    url: `${SITE.url}/blog/`,
    isPartOf: { '@id': `${SITE.url}/#website` },
    // Each entry is emitted as a standalone Article, so it has to satisfy the
    // same rich-result requirements as the article pages themselves —
    // headline, image, datePublished, author and publisher. A headline-and-URL
    // stub is not a valid Article node.
    hasPart: allArticles.slice(0, 20).map((a) => ({
      '@type': 'Article',
      headline: a.data.title,
      url: `${SITE.url}/blog/${a.id}/`,
      image: [`${SITE.url}/og/blog-${a.id}.png`],
      datePublished: a.data.pubDate.toISOString(),
      dateModified: (a.data.updatedDate ?? a.data.pubDate).toISOString(),
      author: { '@type': 'Person', name: resolveEditor(a.data.author).name },
      publisher: { '@id': `${SITE.url}/#organization` },
    })),
  },
]);
---

<BaseLayout
  title="Hostinger Articles, Reviews and Tutorials"
  description={`${allArticles.length} hands-on Hostinger articles: independent reviews, buying guides, hPanel tutorials, working promo codes and fixes for the errors users hit most.`}
  canonical={`${SITE.url}/blog/`}
  schema={schema}
  keywords={['hostinger tutorial', 'hostinger review', 'hostinger guide', 'hostinger help']}
>
  <header class="border-b border-line bg-white">
    <div class="container-page py-8 lg:py-10">
      <Breadcrumbs items={breadcrumbs} />
      <div class="mt-5 max-w-3xl">
        <p class="eyebrow">{allArticles.length} articles · updated weekly</p>
        <h1 class="mt-3 text-[1.875rem] font-extrabold leading-[1.12] tracking-[-0.03em] sm:text-[2.5rem]">
          Hostinger research, written by people who use it
        </h1>
        <p class="mt-4 text-[1.0625rem] leading-relaxed text-ink-600">
          Reviews with the renewal prices included, buying guides that do the maths, hPanel tutorials
          that assume nothing, and fixes for the errors Hostinger customers actually hit.
        </p>
      </div>

      <ul class="mt-6 flex flex-wrap gap-2">
        {
          CATEGORY_LIST.map((category) => (
            <li>
              <a href={`/category/${category.key}/`} class="btn btn-outline btn-sm">
                {category.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </header>

  <div class="container-page py-10 lg:py-12">
    <ArticleListing
      articles={articles}
      allArticles={allArticles}
      currentPage={1}
      totalPages={totalPages}
      totalCount={allArticles.length}
    />
  </div>
</BaseLayout>
