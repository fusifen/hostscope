---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PlanCard from '../../components/PlanCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import AffiliateButton from '../../components/AffiliateButton.astro';
import FAQ from '../../components/FAQ.astro';
import { SITE } from '../../consts';
import { breadcrumbSchema, faqSchema, graph, organizationSchema } from '../../lib/seo';
import { discountPercent, renewalIncrease } from '../../lib/pricing';

const plans = await getCollection('plans');

const GROUPS = [
  { key: 'web', label: 'Web hosting', blurb: 'Fully managed shared hosting for first sites, blogs and small businesses.' },
  { key: 'cloud', label: 'Cloud hosting', blurb: 'More CPU, more RAM, a dedicated IP — still fully managed, no server admin.' },
  { key: 'vps', label: 'VPS hosting', blurb: 'Self-managed KVM servers with root access. Cheapest cost per GB of RAM.' },
  { key: 'builder', label: 'Website Builder', blurb: 'No-code site building with AI assistance. Best for portfolios and simple sites.' },
] as const;

const byGroup = (key: string) =>
  plans.filter((p) => p.data.group === key).sort((a, b) => a.data.order - b.data.order);

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Plans', href: '/plans/' },
];

const faqs = [
  {
    question: 'How many Hostinger plans are there?',
    answer:
      'Ten that we cover: three web hosting tiers (Premium, Unlimited, Cloud Startup), three cloud tiers (Cloud Startup, Cloud Professional, Cloud Enterprise), four VPS tiers (KVM 1, 2, 4 and 8) and the Website Builder. Hostinger also sells agency plans, managed WordPress and ecommerce plans that sit on the same infrastructure.',
  },
  {
    question: 'What is the difference between web hosting and cloud hosting at Hostinger?',
    answer:
      'Both are fully managed and use the same hPanel. Cloud plans give you more CPU cores, more RAM, a dedicated IP address, higher PHP worker limits and on-demand backups. Web hosting starts at $2.99/mo; cloud starts at $7.99/mo. If your site is small and steady, web hosting is enough.',
  },
  {
    question: 'Should I choose a VPS or a managed plan?',
    answer:
      'Choose a VPS if you are comfortable with SSH, want root access, or need a specific stack that shared hosting cannot run. Choose a managed plan if you want WordPress, email and SSL to just work. A KVM 2 VPS gives you 8 GB of RAM for $8.99/mo — the same money buys 3 GB on a managed plan — but you administer everything yourself.',
  },
  {
    question: 'Can I switch plans later?',
    answer:
      'Yes, upgrades are done in place through hPanel without migrating your files, and you pay the pro-rated difference for the rest of the term. Moving from a managed plan to a VPS is a real migration, though — you rebuild the environment rather than clicking a button.',
  },
];

const schema = graph([
  organizationSchema(),
  breadcrumbSchema(breadcrumbs),
  faqSchema(faqs),
]);
---

<BaseLayout
  title="Hostinger Plans Compared: All 10 Tiers, Specs and Prices"
  description="All 10 Hostinger plans in one place — Premium, Unlimited, Cloud, KVM 1–8 VPS and the Website Builder — with specs, prices and who each is for."
  canonical={`${SITE.url}/plans/`}
  schema={schema}
  keywords={['hostinger plans', 'hostinger plan comparison', 'hostinger vps plans', 'hostinger cloud plans']}
>
  <header class="border-b border-line bg-white">
    <div class="container-page py-8 lg:py-10">
      <Breadcrumbs items={breadcrumbs} />
      <div class="mt-5 max-w-3xl">
        <p class="eyebrow">10 plans · {plans.length} reviews</p>
        <h1 class="mt-3 text-[1.875rem] font-extrabold leading-[1.12] tracking-[-0.03em] sm:text-[2.5rem]">
          Every Hostinger plan, and who each one is actually for
        </h1>
        <p class="mt-4 text-[1.0625rem] leading-relaxed text-ink-600">
          We review each tier on its own terms — what the specs mean in practice, where it stops
          being enough, and the point at which the next plan up is the cheaper decision.
        </p>
      </div>
    </div>
  </header>

  {
    GROUPS.map((group) => {
      const groupPlans = byGroup(group.key);
      if (groupPlans.length === 0) return null;
      return (
        <section class="section" id={group.key}>
          <div class="container-page">
            <div class="flex flex-wrap items-end justify-between gap-4">
              <SectionHeading eyebrow={group.label} title={`${groupPlans.length} ${group.label.toLowerCase()} ${groupPlans.length === 1 ? 'plan' : 'plans'}`} description={group.blurb} />
              <a href="/pricing/" class="btn btn-outline btn-sm shrink-0">
                Compare specs
              </a>
            </div>

            <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
              {groupPlans.map((plan, i) => (
                <PlanCard plan={plan} recommended={i === 0 && groupPlans.length > 1} />
              ))}
            </div>

            {/* Compact spec table */}
            <div class="mt-6 scroll-x rounded-2xl border border-line bg-white">
              <table class="w-full min-w-[42rem] border-collapse text-[0.8125rem]">
                <caption class="sr-only">Specifications for Hostinger {group.label.toLowerCase()} plans</caption>
                <thead>
                  <tr class="border-b border-line bg-ink-50">
                    <th scope="col" class="px-4 py-3 text-left text-[0.6875rem] font-bold tracking-[0.06em] text-ink-500 uppercase">Plan</th>
                    <th scope="col" class="px-4 py-3 text-left text-[0.6875rem] font-bold tracking-[0.06em] text-ink-500 uppercase">Intro</th>
                    <th scope="col" class="px-4 py-3 text-left text-[0.6875rem] font-bold tracking-[0.06em] text-ink-500 uppercase">Renews at</th>
                    <th scope="col" class="px-4 py-3 text-left text-[0.6875rem] font-bold tracking-[0.06em] text-ink-500 uppercase">Jump</th>
                    <th scope="col" class="px-4 py-3 text-left text-[0.6875rem] font-bold tracking-[0.06em] text-ink-500 uppercase">CPU / RAM</th>
                    <th scope="col" class="px-4 py-3 text-left text-[0.6875rem] font-bold tracking-[0.06em] text-ink-500 uppercase">Storage</th>
                    <th scope="col" class="px-4 py-3 text-left text-[0.6875rem] font-bold tracking-[0.06em] text-ink-500 uppercase">Websites</th>
                    <th scope="col" class="px-4 py-3 text-left text-[0.6875rem] font-bold tracking-[0.06em] text-ink-500 uppercase">Backups</th>
                  </tr>
                </thead>
                <tbody>
                  {groupPlans.map((plan, i) => {
                    const jump = renewalIncrease(plan.data.pricing.promoMonthly, plan.data.pricing.renewalMonthly);
                    return (
                      <tr class:list={['border-b border-line last:border-0', i % 2 === 1 && 'bg-ink-50/40']}>
                        <th scope="row" class="px-4 py-3 text-left font-semibold text-ink-900">
                          <a href={`/plans/${plan.id}/`} class="hover:text-brand-700 hover:underline">{plan.data.name}</a>
                          {plan.data.badge && <span class="ml-2 pill pill-brand !px-1.5 !py-0.5 !text-[0.5625rem]">{plan.data.badge}</span>}
                        </th>
                        <td class="px-4 py-3 font-semibold text-ink-800">${plan.data.pricing.promoMonthly.toFixed(2)}/mo</td>
                        <td class="px-4 py-3 text-ink-600">${plan.data.pricing.renewalMonthly.toFixed(2)}/mo</td>
                        <td class="px-4 py-3"><span class:list={['pill', jump > 100 ? 'pill-coral' : 'pill-sun']}>+{jump}%</span></td>
                        <td class="px-4 py-3 text-ink-600">{plan.data.specs.cpuCores} core(s) · {plan.data.specs.ram}</td>
                        <td class="px-4 py-3 text-ink-600">{plan.data.specs.storage} {plan.data.specs.storageType}</td>
                        <td class="px-4 py-3 text-ink-600">{plan.data.specs.websites}</td>
                        <td class="px-4 py-3 text-ink-600">{plan.data.specs.backups}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </div>
        </section>
      );
    })
  }

  <section class="border-y border-line bg-white section">
    <div class="container-page max-w-3xl">
      <SectionHeading eyebrow="Choosing" title="Plan selection questions" align="center" class="mx-auto" />
      <FAQ faqs={faqs} title="Hostinger plan FAQ" class="mt-9" />
      <div class="mt-8 rounded-2xl border border-brand-200 bg-gradient-to-br from-brand-50 to-white p-6 text-center">
        <p class="text-[0.9375rem] font-bold text-ink-950">Want a recommendation instead?</p>
        <p class="mx-auto mt-2 max-w-md text-[0.875rem] leading-relaxed text-ink-600">
          Four questions, twenty seconds, and we show the reasoning so you can disagree with it.
        </p>
        <div class="mt-5 flex flex-wrap justify-center gap-3">
          <a href="/tools/plan-finder/" class="btn btn-primary btn-lg">Open the plan finder</a>
          <AffiliateButton placement="plan-card" campaign="plans-index" label="Browse on Hostinger" size="lg" variant="outline" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
