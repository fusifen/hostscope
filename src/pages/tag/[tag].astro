---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleListing from '../../components/ArticleListing.astro';
import { SITE } from '../../consts';
import { breadcrumbSchema, graph, organizationSchema } from '../../lib/seo';
import { slugify } from '../../lib/pricing';

export async function getStaticPaths() {
  const articles = (await getCollection('articles')).filter((a) => !a.data.draft);

  // Build a slug → label map so the page can show the human-readable tag
  const tagMap = new Map<string, { label: string; count: number }>();
  articles.forEach((article) => {
    article.data.tags.forEach((tag) => {
      const slug = slugify(tag);
      const existing = tagMap.get(slug);
      tagMap.set(slug, {
        label: existing?.label ?? tag,
        count: (existing?.count ?? 0) + 1,
      });
    });
  });

  return [...tagMap.entries()].map(([slug, meta]) => ({
    params: { tag: slug },
    props: { tagSlug: slug, tagLabel: meta.label, count: meta.count },
  }));
}

const { tagSlug, tagLabel, count } = Astro.props;

const allArticles = (await getCollection('articles')).filter((a) => !a.data.draft);
const articles = allArticles
  .filter((a) => a.data.tags.some((t) => slugify(t) === tagSlug))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Articles', href: '/blog/' },
  { name: `Tag: ${tagLabel}`, href: `/tag/${tagSlug}/` },
];

// Related tags: the tags most often co-occurring with this one
const coOccurrence = new Map<string, number>();
articles.forEach((article) => {
  article.data.tags.forEach((tag) => {
    const slug = slugify(tag);
    if (slug === tagSlug) return;
    coOccurrence.set(tag, (coOccurrence.get(tag) ?? 0) + 1);
  });
});
const relatedTags = [...coOccurrence.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 10);

const schema = graph([
  organizationSchema(),
  breadcrumbSchema(breadcrumbs),
  {
    '@type': 'CollectionPage',
    name: `Articles tagged "${tagLabel}"`,
    url: `${SITE.url}/tag/${tagSlug}/`,
    isPartOf: { '@id': `${SITE.url}/#website` },
  },
]);
---

<BaseLayout
  title={`Hostinger: ${tagLabel} — ${count} Article${count === 1 ? '' : 's'}`}
  description={`Independent HostScope articles tagged "${tagLabel}" — Hostinger reviews, guides and tutorials with prices verified against hostinger.com.`}
  canonical={`${SITE.url}/tag/${tagSlug}/`}
  schema={schema}
  keywords={[tagLabel, `hostinger ${tagLabel}`]}
>
  <header class="border-b border-line bg-white">
    <div class="container-page py-8 lg:py-10">
      <Breadcrumbs items={breadcrumbs} />
      <div class="mt-5 max-w-3xl">
        <p class="eyebrow">Tag · {count} article{count === 1 ? '' : 's'}</p>
        <h1 class="mt-3 text-[1.75rem] font-extrabold leading-[1.14] tracking-[-0.03em] sm:text-[2.25rem]">
          {tagLabel}
        </h1>
        <p class="mt-4 text-[1.0625rem] leading-relaxed text-ink-600">
          Everything we have published on this topic, newest first.
        </p>
      </div>

      {
        relatedTags.length > 0 && (
          <ul class="mt-6 flex flex-wrap gap-2">
            {relatedTags.map(([tag]) => (
              <li>
                <a href={`/tag/${slugify(tag)}/`} class="pill pill-ink hover:bg-brand-100 hover:text-brand-800">
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </header>

  <div class="container-page py-10 lg:py-12">
    <ArticleListing
      articles={articles}
      allArticles={allArticles}
      currentPage={1}
      totalPages={1}
      totalCount={count}
      activeTag={tagLabel}
    />
  </div>
</BaseLayout>
