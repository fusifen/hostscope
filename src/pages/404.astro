---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
import { breadcrumbSchema, graph, organizationSchema } from '../lib/seo';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Page not found', href: '/404' },
];

const schema = graph([organizationSchema(), breadcrumbSchema(breadcrumbs)]);

const shortcuts = [
  { href: '/pricing/', label: 'Pricing matrix', note: 'Every plan, every renewal rate' },
  { href: '/plans/', label: 'Plan reviews', note: 'All 10 tiers reviewed in depth' },
  { href: '/coupons/', label: 'Deals & promo codes', note: 'What is live right now' },
  { href: '/tools/plan-finder/', label: 'Plan finder', note: 'Four questions, one answer' },
  { href: '/blog/hostinger-review/', label: 'Hostinger review', note: 'Our full editorial verdict' },
  { href: '/category/troubleshooting/', label: 'Fix an error', note: '503s, slow sites, email, SSL' },
];
---

<BaseLayout
  title="Page Not Found"
  description="That page does not exist. Here are the most useful places to go instead."
  noindex
  schema={schema}
  hideStickyBar
>
  <section class="container-page py-16 lg:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-[5rem] font-extrabold leading-none tracking-[-0.05em] text-brand-200 sm:text-[7rem]">
        404
      </p>
      <h1 class="mt-4 text-2xl font-extrabold tracking-[-0.025em] sm:text-3xl">
        We could not find that page
      </h1>
      <p class="mx-auto mt-4 max-w-lg text-[0.9375rem] leading-relaxed text-ink-600">
        The link may be broken, or the page may have been renamed. Everything we publish is reachable
        from the links below — or try the site search via Google with{' '}
        <code class="rounded bg-ink-100 px-1.5 py-0.5 text-[0.8125rem] text-brand-800">
          site:{SITE.url.replace('https://', '')}
        </code>.
      </p>
    </div>

    <div class="mx-auto mt-12 grid max-w-3xl gap-3 sm:grid-cols-2">
      {
        shortcuts.map((item) => (
          <a
            href={item.href}
            class="card card-hover group flex items-center justify-between gap-4 p-4"
          >
            <span class="min-w-0">
              <span class="block text-[0.9375rem] font-bold text-ink-900 group-hover:text-brand-700">
                {item.label}
              </span>
              <span class="mt-0.5 block text-[0.8125rem] text-ink-500">{item.note}</span>
            </span>
            <svg
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="h-4 w-4 shrink-0 text-brand-400 transition-transform group-hover:translate-x-1"
              aria-hidden="true"
            >
              <path d="M3 8h9m0 0-3.5-3.5M12 8l-3.5 3.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        ))
      }
    </div>

    <div class="mx-auto mt-12 max-w-xl text-center">
      <a href="/" class="btn btn-primary btn-lg">Back to the home page</a>
    </div>
  </section>
</BaseLayout>
