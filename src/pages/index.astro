---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AffiliateButton from '../components/AffiliateButton.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PricingMatrix from '../components/PricingMatrix.astro';
import PlanCard from '../components/PlanCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import FAQ from '../components/FAQ.astro';
import StatsStrip from '../components/StatsStrip.astro';
import { affiliateUrl, AFFILIATE, SITE, CATEGORIES } from '../consts';
import { discountPercent, termTotal } from '../lib/pricing';
import {
  breadcrumbSchema,
  faqSchema,
  graph,
  hostingProductSchema,
  organizationSchema,
  websiteSchema,
} from '../lib/seo';

const plans = (await getCollection('plans')).sort(
  (a, b) => a.data.pricing.promoMonthly - b.data.pricing.promoMonthly,
);
const articles = (await getCollection('articles')).filter((a) => !a.data.draft);
const comparisons = await getCollection('comparisons');

const webPlans = plans.filter((p) => p.data.group === 'web');
const heroPlan = plans.find((p) => p.id === 'unlimited') ?? plans[0];

const featured = articles
  .filter((a) => a.data.featured)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const latest = articles
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);

const popular = [
  'hostinger-review',
  'cheapest-way-to-buy-hostinger',
  'which-hostinger-plan-should-you-choose',
  'hostinger-renewal-prices-explained',
  'is-hostinger-good',
  'hpanel-beginner-guide',
]
  .map((slug) => articles.find((a) => a.id === slug))
  .filter((a): a is NonNullable<typeof a> => Boolean(a));

const homeFaqs = [
  {
    question: 'How much does Hostinger actually cost?',
    answer:
      'The cheapest plan, Premium, is $2.99/mo on the 48-month term — $143.52 paid upfront. Unlimited is $3.99/mo ($191.52 upfront) and Cloud Startup is $7.99/mo ($383.52 upfront). VPS plans start at $6.49/mo on a 24-month term. After the intro term, prices renew at $10.99, $16.99 and $25.99 respectively.',
  },
  {
    question: 'Is the 48-month term worth it?',
    answer:
      'It is the cheapest per month and the rate is locked for the full term. The trade-off is that you pay the whole amount upfront and you are tied to Hostinger for four years. If you are confident you will keep the site, take it. If you are testing an idea, a 12-month term costs more per month but keeps your options open.',
  },
  {
    question: 'What does the free domain include?',
    answer:
      'Every annual or longer hosting plan includes a free domain for the first 12 months. It is a real registration in your name — you claim it from the dashboard after checkout. From year two it renews at the standard domain price, typically around $9.99–$15.99/yr for a .com.',
  },
  {
    question: 'Can I get a refund if I do not like it?',
    answer:
      'Yes. Hostinger offers a 30-day money-back guarantee on all plans. Request it through hPanel or support within 30 days of purchase. Domain registration fees are generally not refundable, so the hosting portion is what comes back.',
  },
  {
    question: 'Which Hostinger plan is best for a WordPress site?',
    answer:
      'Unlimited is the sweet spot for most WordPress sites: 2 CPU cores, 3 GB RAM, 50 GB NVMe, daily backups and a dedicated IP for $3.99/mo. Start on Premium only if the site is a simple brochure or blog and you want the lowest possible upfront cost.',
  },
  {
    question: 'Is Hostinger good for beginners?',
    answer:
      'Yes — hPanel is one of the friendlier control panels, there is a one-click WordPress installer, an AI website builder for people who do not want to touch code, and 24/7 support in more than ten languages. The main beginner trap is not realising the advertised monthly price requires paying the whole term upfront.',
  },
];

const schema = graph([
  organizationSchema(),
  websiteSchema(),
  breadcrumbSchema([{ name: 'Home', href: '/' }]),
  hostingProductSchema({
    name: 'Hostinger Web Hosting',
    description:
      'Hostinger web hosting plans — shared, cloud and VPS — with prices, specs and renewal rates verified against hostinger.com.',
    url: SITE.url,
    image: SITE.defaultOgImage,
    lowPrice: 2.99,
    highPrice: 25.99,
    ratingValue: 4.5,
    reviewCount: 1842,
    planNames: plans.map((p) => p.data.name),
  }),
  faqSchema(homeFaqs),
]);

const heroOff = discountPercent(
  heroPlan.data.pricing.regularMonthly,
  heroPlan.data.pricing.promoMonthly,
);
const heroTotal = termTotal(
  heroPlan.data.pricing.promoMonthly,
  heroPlan.data.pricing.termMonths,
);

const USE_CASES = [
  {
    icon: 'blog',
    title: 'Your first website',
    body: 'A blog, portfolio or CV site that needs to be online, fast, with a real domain and professional email.',
    plan: 'Premium',
    href: '/plans/premium/',
    price: '$2.99/mo',
  },
  {
    icon: 'store',
    title: 'A small online store',
    body: 'WooCommerce with daily backups, a dedicated IP and enough PHP workers to survive a sale.',
    plan: 'Unlimited',
    href: '/plans/unlimited/',
    price: '$3.99/mo',
  },
  {
    icon: 'growth',
    title: 'A growing business site',
    body: 'Steady traffic, real revenue, no appetite for resource ceilings. Four cores and 100 GB NVMe.',
    plan: 'Cloud Startup',
    href: '/plans/cloud-startup/',
    price: '$7.99/mo',
  },
  {
    icon: 'server',
    title: 'Apps, APIs and dev work',
    body: 'Full root access, dedicated RAM and 1 Gbps networking at a fraction of managed prices.',
    plan: 'KVM 2 VPS',
    href: '/plans/kvm-2/',
    price: '$8.99/mo',
  },
];

const FEATURES = [
  {
    title: 'A free domain for a year',
    body: 'Included on every annual or longer plan. Worth roughly $10–16 in year one, and it registers in your name.',
    icon: 'globe',
  },
  {
    title: 'Free SSL, installed automatically',
    body: 'Unlimited certificates on most plans, issued and renewed without you touching anything.',
    icon: 'lock',
  },
  {
    title: 'Business email bundled in',
    body: '2 mailboxes per site on Premium, 5 on Unlimited, 10 on Cloud — free for the first year.',
    icon: 'mail',
  },
  {
    title: 'LiteSpeed, NVMe and a built-in CDN',
    body: 'The stack is genuinely fast, and the CDN is switched on by default rather than sold as an add-on.',
    icon: 'bolt',
  },
  {
    title: 'Free automatic migration',
    body: 'Submit a request and their team moves your existing site, usually in about 20 minutes, with no downtime.',
    icon: 'move',
  },
  {
    title: 'AI tools that do real work',
    body: 'An AI website builder, AI-assisted troubleshooting and Hostinger Agent for WordPress management.',
    icon: 'sparkle',
  },
];
---

<BaseLayout
  title="Hostinger Reviews, Real Prices and Plan Comparisons"
  description={SITE.description}
  canonical={SITE.url}
  schema={schema}
  keywords={[
    'hostinger',
    'hostinger review',
    'hostinger pricing',
    'hostinger plans',
    'hostinger coupon',
    'web hosting',
  ]}
>
  <!-- ══ HERO ═══════════════════════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-ink-950 text-white">
    <div class="absolute inset-0 grid-backdrop opacity-60" aria-hidden="true"></div>
    <div
      class="absolute -top-40 left-1/2 h-[36rem] w-[36rem] -translate-x-1/2 rounded-full opacity-40 blur-3xl"
      style="background:radial-gradient(circle, #673DE6 0%, transparent 70%)"
      aria-hidden="true"
      data-parallax="40"
    >
    </div>

    <div class="container-page relative py-14 lg:py-20">
      <div class="grid gap-12 lg:grid-cols-[1.15fr_1fr] lg:items-center">
        <div>
          <p
            class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3 py-1.5 text-[0.6875rem] font-bold tracking-[0.08em] text-brand-200 uppercase backdrop-blur"
            data-hero-anim
          >
            <span class="inline-flex h-1.5 w-1.5 animate-pulse rounded-full bg-mint-500"></span>
            Prices verified {SITE.pricingVerified}
          </p>

          <h1
            class="mt-5 text-[2rem] font-extrabold leading-[1.08] tracking-[-0.035em] !text-white sm:text-[2.75rem] lg:text-[3.25rem]"
            data-hero-anim
          >
            Hostinger, minus the marketing.
            <span class="block text-brand-300">Real prices. Real limits.</span>
          </h1>

          <p class="mt-5 max-w-xl text-[1.0625rem] leading-relaxed text-ink-300" data-hero-anim>
            Every plan, every spec and — crucially — every <strong class="font-semibold text-white"
              >renewal price</strong
            >, laid out side by side. Then plain-English guidance on which tier you actually need and
            how to pay the least for it.
          </p>

          <div class="mt-7 flex flex-wrap items-center gap-3" data-hero-anim>
            <AffiliateButton
              placement="hero-primary"
              campaign="home-hero"
              label="Claim Hostinger deal"
              sublabel={`Save ${heroOff}%`}
              size="xl"
              variant="primary"
              pulse
            />
            <a href="/pricing/" class="btn btn-ghost-light btn-xl">Compare all plans</a>
          </div>

          <p class="mt-3 text-[0.6875rem] text-ink-400" data-hero-anim>
            Affiliate link · you pay the same price · we may earn a commission
          </p>

          <div class="mt-10 border-t border-white/10 pt-8" data-hero-anim>
            <StatsStrip light />
          </div>
        </div>

        <!-- Hero plan card -->
        <div class="relative" data-hero-anim>
          <div
            class="absolute -inset-4 rounded-3xl opacity-30 blur-2xl"
            style="background:linear-gradient(135deg,#673DE6,#10B981)"
            aria-hidden="true"
          >
          </div>
          <div class="relative rounded-2xl border border-white/12 bg-white/95 p-6 shadow-[var(--shadow-pop)] backdrop-blur">
            <div class="flex items-center justify-between gap-3">
              <span class="pill pill-solid">Editor's top pick</span>
              <span class="text-[0.6875rem] font-semibold text-ink-400">
                {heroPlan.data.pricing.termLabel} term
              </span>
            </div>

            <h2 class="mt-4 text-xl font-extrabold text-ink-950">{heroPlan.data.name}</h2>
            <p class="mt-1.5 text-[0.8125rem] leading-snug text-ink-500">
              {heroPlan.data.tagline}
            </p>

            <div class="mt-5 flex items-baseline gap-2">
              <span class="text-[2.5rem] font-extrabold leading-none tracking-[-0.04em] text-ink-950">
                ${heroPlan.data.pricing.promoMonthly.toFixed(2)}
              </span>
              <span class="text-sm font-semibold text-ink-500">/mo</span>
              <span class="text-[0.8125rem] font-medium text-ink-400 line-through">
                ${heroPlan.data.pricing.regularMonthly.toFixed(2)}
              </span>
            </div>
            <p class="mt-2 text-[0.75rem] text-ink-500">
              ${heroTotal.toFixed(2)} upfront · renews at ${heroPlan.data.pricing.renewalMonthly.toFixed(2)}/mo
            </p>

            <ul class="mt-5 space-y-2.5 border-t border-line pt-5">
              {
                heroPlan.data.highlights.slice(0, 5).map((item) => (
                  <li class="flex gap-2.5 text-[0.8125rem] leading-snug text-ink-700">
                    <svg
                      viewBox="0 0 16 16"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.4"
                      class="mt-1 h-3 w-3 shrink-0 text-mint-600"
                      aria-hidden="true"
                    >
                      <path d="m3.5 8.5 3 3 6-7" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>

            <div class="mt-5 space-y-2">
              <AffiliateButton
                placement="hero-secondary"
                plan={heroPlan.id}
                label="Get this plan"
                size="lg"
                variant="mint"
                fullWidth
              />
              <a
                href={`/plans/${heroPlan.id}/`}
                class="block text-center text-[0.75rem] font-semibold text-ink-500 transition hover:text-brand-700"
              >
                Read the full review
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ WHY TRUST US ═══════════════════════════════════════════════════ -->
  <section class="border-b border-line bg-white">
    <div class="container-page py-6">
      <div class="grid gap-4 sm:grid-cols-3">
        {
          [
            {
              title: 'We publish the renewal price',
              body: 'Every plan page shows the intro rate and what you pay after it ends.',
            },
            {
              title: 'We publish the limits',
              body: 'Inodes, PHP workers, memory caps, backup frequency — the specs marketing pages skip.',
            },
            {
              title: 'We say when not to buy',
              body: 'Each plan page lists who it is wrong for. Sometimes the answer is "spend $1 more".',
            },
          ].map((item) => (
            <div class="flex gap-3">
              <span
                class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-mint-100 text-mint-700"
                aria-hidden="true"
              >
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" class="h-3.5 w-3.5">
                  <path d="m3.5 8.5 3 3 6-7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <div>
                <p class="text-[0.875rem] font-bold text-ink-900">{item.title}</p>
                <p class="mt-0.5 text-[0.8125rem] leading-snug text-ink-500">{item.body}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ══ PRICING MATRIX ═════════════════════════════════════════════════ -->
  <section class="section" id="pricing">
    <div class="container-page">
      <SectionHeading
        eyebrow="Live pricing"
        title="Every Hostinger plan, one honest matrix"
        description="Switch between product families, and flip the price view to see what you pay after the intro term ends. Nothing is hidden behind a 'contact us'."
        align="center"
        class="mx-auto"
      />
      <div class="mt-10">
        <PricingMatrix plans={plans} defaultGroup="web" placement="pricing-matrix" />
      </div>
    </div>
  </section>

  <!-- ══ USE CASES ══════════════════════════════════════════════════════ -->
  <section class="border-y border-line bg-white section">
    <div class="container-page">
      <SectionHeading
        eyebrow="Start here"
        title="Which Hostinger product do you actually need?"
        description="Four realistic scenarios and the plan we would buy for each. If you want a personalised answer, the plan finder takes about 20 seconds."
      />

      <div class="mt-10 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        {
          USE_CASES.map((useCase) => (
            <a
              href={useCase.href}
              class="card card-hover group flex flex-col p-5"
              data-reveal
            >
              <span
                class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-brand-500 to-brand-800 text-white"
                aria-hidden="true"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5">
                  {useCase.icon === 'blog' && <path d="M5 4h14v16H5zM8 8h8M8 12h8M8 16h4" stroke-linecap="round" />}
                  {useCase.icon === 'store' && <path d="M4 8h16l-1.4 11.2a1.5 1.5 0 0 1-1.5 1.3H6.9a1.5 1.5 0 0 1-1.5-1.3L4 8Zm4 0V6a4 4 0 0 1 8 0v2" stroke-linecap="round" stroke-linejoin="round" />}
                  {useCase.icon === 'growth' && <path d="M4 19h16M7 19v-6M12 19V7M17 19v-9" stroke-linecap="round" />}
                  {useCase.icon === 'server' && <path d="M4 6h16v5H4zM4 13h16v5H4zM7.5 8.5h.01M7.5 15.5h.01" stroke-linecap="round" />}
                </svg>
              </span>
              <h3 class="mt-4 text-[1.0625rem] font-bold tracking-[-0.015em]">{useCase.title}</h3>
              <p class="mt-2 flex-1 text-[0.875rem] leading-relaxed text-ink-600">{useCase.body}</p>
              <div class="mt-4 flex items-center justify-between border-t border-line pt-3">
                <span class="text-[0.75rem] font-bold text-brand-700">{useCase.plan}</span>
                <span class="text-[0.8125rem] font-extrabold text-ink-900">{useCase.price}</span>
              </div>
            </a>
          ))
        }
      </div>

      <div class="mt-6 text-center">
        <a href="/tools/plan-finder/" class="btn btn-outline btn-lg">
          Take the 20-second plan finder
        </a>
      </div>
    </div>
  </section>

  <!-- ══ FEATURES ═══════════════════════════════════════════════════════ -->
  <section class="section">
    <div class="container-page">
      <SectionHeading
        eyebrow="What you're paying for"
        title="The parts of Hostinger that actually justify the price"
        description="Strip away the discount and this is what is left. These are the features that genuinely change what a year of hosting costs you elsewhere."
      />
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {
          FEATURES.map((feature) => (
            <div class="card p-5" data-reveal>
              <span
                class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-50 text-brand-700"
                aria-hidden="true"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5">
                  {feature.icon === 'globe' && <path d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm0 0c2.5 2.4 3.8 5.5 3.8 9s-1.3 6.6-3.8 9m0-18c-2.5 2.4-3.8 5.5-3.8 9s1.3 6.6 3.8 9M3.4 9h17.2M3.4 15h17.2" stroke-linecap="round" />}
                  {feature.icon === 'lock' && <path d="M6 10.5h12V20H6zM8.5 10.5V7.8a3.5 3.5 0 0 1 7 0v2.7" stroke-linecap="round" stroke-linejoin="round" />}
                  {feature.icon === 'mail' && <path d="M3.5 6h17v12h-17zM3.5 6.5 12 13l8.5-6.5" stroke-linecap="round" stroke-linejoin="round" />}
                  {feature.icon === 'bolt' && <path d="M13 2 4.5 13.5H11l-1 8.5 8.5-11.5H12l1-8.5Z" stroke-linecap="round" stroke-linejoin="round" />}
                  {feature.icon === 'move' && <path d="M4 12h16m0 0-5-5m5 5-5 5M4 6v12" stroke-linecap="round" stroke-linejoin="round" />}
                  {feature.icon === 'sparkle' && <path d="M12 3v4m0 10v4M3 12h4m10 0h4M6.5 6.5l2.8 2.8m5.4 5.4 2.8 2.8m0-11-2.8 2.8m-5.4 5.4-2.8 2.8" stroke-linecap="round" />}
                </svg>
              </span>
              <h3 class="mt-4 text-[1.0625rem] font-bold tracking-[-0.015em]">{feature.title}</h3>
              <p class="mt-2 text-[0.875rem] leading-relaxed text-ink-600">{feature.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ══ DEAL BANNER ════════════════════════════════════════════════════ -->
  <section class="container-page">
    <div
      class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-brand-700 via-brand-800 to-brand-950 p-7 text-white shadow-[var(--shadow-pop)] sm:p-10"
      data-reveal
    >
      <div class="absolute inset-0 grid-backdrop opacity-40" aria-hidden="true"></div>
      <div class="relative grid gap-8 lg:grid-cols-[1.4fr_auto] lg:items-center">
        <div>
          <p class="eyebrow !text-brand-200">Current promotion</p>
          <h2 class="mt-3 max-w-2xl text-2xl font-extrabold leading-tight !text-white sm:text-3xl">
            Up to 79% off, a free domain for a year, and 30 days to change your mind.
          </h2>
          <p class="mt-4 max-w-2xl text-[0.9375rem] leading-relaxed text-brand-100">
            The biggest discount is built into the long-term plans rather than a stackable coupon —
            so the term you choose matters more than the code you type. Use promo code
            <strong class="font-bold text-white">{AFFILIATE.defaultCoupon}</strong> for a further{' '}
            {AFFILIATE.couponDiscount}% off at checkout, and compare the term totals before you
            commit.
          </p>
          <ul class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-[0.8125rem] text-brand-100">
            <li class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-mint-400"></span>Free SSL on every plan
            </li>
            <li class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-mint-400"></span>Free website migration
            </li>
            <li class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-mint-400"></span>24/7 support, 10+ languages
            </li>
          </ul>
        </div>
        <div class="flex flex-col items-start gap-3 lg:items-end">
          <AffiliateButton
            placement="home-section"
            campaign="deal-banner"
            label="Claim the deal"
            size="xl"
            variant="mint"
          />
          <a
            href="/coupons/"
            class="text-[0.8125rem] font-semibold text-brand-200 underline decoration-brand-400/50 underline-offset-2 hover:text-white"
          >
            See all working promo codes →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ TOP PICKS ══════════════════════════════════════════════════════ -->
  <section class="section">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <SectionHeading
          eyebrow="Editor's picks"
          title="The three plans we recommend most"
          description="Chosen on value rather than commission — these are the tiers that hold up under real workloads."
        />
        <a href="/plans/" class="btn btn-outline btn-md shrink-0">All 10 plans</a>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {webPlans.map((plan, i) => <PlanCard plan={plan} recommended={i === 1} />)}
      </div>

      <div class="mt-5 grid gap-5 md:grid-cols-3">
        {
          plans
            .filter((p) => p.data.group === 'vps')
            .slice(0, 3)
            .map((plan) => <PlanCard plan={plan} variant="mini" />)
        }
      </div>
    </div>
  </section>

  <!-- ══ ARTICLES ═══════════════════════════════════════════════════════ -->
  <section class="border-y border-line bg-white section">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-[1fr_20rem]">
        <div>
          <SectionHeading
            eyebrow="Research & tutorials"
            title="Guides written after actually using it"
            description="Reviews, buying guides and step-by-step fixes for the problems Hostinger customers hit most."
          />

          <div class="mt-8 grid gap-5 sm:grid-cols-2">
            {featured.map((article) => <ArticleCard article={article} />)}
          </div>

          <div class="mt-8">
            <h3 class="text-[0.9375rem] font-bold text-ink-900">Latest articles</h3>
            <div class="mt-4 grid gap-4 sm:grid-cols-2">
              {latest.map((article) => <ArticleCard article={article} />)}
            </div>
          </div>

          <div class="mt-8 flex flex-wrap gap-2">
            {
              Object.entries(CATEGORIES).map(([key, value]) => (
                <a href={`/category/${key}/`} class="btn btn-outline btn-sm">
                  {value.label}
                </a>
              ))
            }
          </div>
        </div>

        <aside class="space-y-5">
          <div class="rounded-2xl border border-line bg-canvas p-5">
            <h3 class="text-[0.9375rem] font-bold text-ink-900">Most read this month</h3>
            <ol class="mt-3 space-y-1">
              {
                popular.map((article, i) => (
                  <li class="flex gap-3">
                    <span class="mt-2 text-[0.8125rem] font-extrabold text-brand-300">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <ArticleCard article={article} variant="compact" class="flex-1" />
                  </li>
                ))
              }
            </ol>
          </div>

          <div class="rounded-2xl border border-line bg-canvas p-5">
            <h3 class="text-[0.9375rem] font-bold text-ink-900">Head to head</h3>
            <ul class="mt-3 space-y-1.5">
              {
                comparisons.slice(0, 6).map((comparison) => (
                  <li>
                    <a
                      href={`/compare/${comparison.id}/`}
                      class="flex items-center justify-between gap-2 rounded-lg px-2 py-2 text-[0.8125rem] font-medium text-ink-600 transition hover:bg-white hover:text-brand-700"
                    >
                      <span>Hostinger vs {comparison.data.competitor}</span>
                      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" class="h-3 w-3 shrink-0 opacity-40" aria-hidden="true">
                        <path d="M3 8h9m0 0-3.5-3.5M12 8l-3.5 3.5" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

