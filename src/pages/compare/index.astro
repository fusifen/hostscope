---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import AffiliateButton from '../../components/AffiliateButton.astro';
import { SITE } from '../../consts';
import { breadcrumbSchema, graph, organizationSchema } from '../../lib/seo';

const comparisons = (await getCollection('comparisons')).sort(
  (a, b) => a.data.competitor.localeCompare(b.data.competitor),
);

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Comparisons', href: '/compare/' },
];

const schema = graph([
  organizationSchema(),
  breadcrumbSchema(breadcrumbs),
  {
    '@type': 'CollectionPage',
    name: 'Hostinger comparisons',
    description:
      'Hostinger measured against the hosting companies buyers most often consider instead.',
    url: `${SITE.url}/compare/`,
    isPartOf: { '@id': `${SITE.url}/#website` },
  },
]);
---

<BaseLayout
  title="Hostinger Comparisons: How It Stacks Up Against Rival Hosts"
  description="Head-to-head Hostinger comparisons against Bluehost, SiteGround, GoDaddy, Namecheap, HostGator and Cloudways — scored row by row."
  canonical={`${SITE.url}/compare/`}
  schema={schema}
  keywords={['hostinger vs bluehost', 'hostinger vs siteground', 'hostinger comparison']}
>
  <header class="border-b border-line bg-white">
    <div class="container-page py-8 lg:py-10">
      <Breadcrumbs items={breadcrumbs} />
      <div class="mt-5 max-w-3xl">
        <p class="eyebrow">{comparisons.length} head-to-heads</p>
        <h1 class="mt-3 text-[1.875rem] font-extrabold leading-[1.12] tracking-[-0.03em] sm:text-[2.5rem]">
          Hostinger versus everyone else
        </h1>
        <p class="mt-4 text-[1.0625rem] leading-relaxed text-ink-600">
          Each comparison is scored on the things that change your bill and your workload: total cost
          of ownership, resource allocation, backup frequency, migration support and control panel.
          Competitors win rows where they genuinely lead — a comparison where one side wins everything
          is not a comparison.
        </p>
      </div>
    </div>
  </header>

  <section class="container-page py-10 lg:py-14">
    <div class="grid gap-5 md:grid-cols-2">
      {
        comparisons.map((comparison) => {
          const hostingerWins = comparison.data.rows.filter((r) => r.edge === 'hostinger').length;
          const competitorWins = comparison.data.rows.filter(
            (r) => r.edge === 'competitor',
          ).length;
          return (
            <a
              href={`/compare/${comparison.id}/`}
              class="card card-hover group flex flex-col p-5"
              data-reveal
            >
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <p class="text-[0.6875rem] font-bold tracking-[0.08em] text-brand-700 uppercase">
                    Head to head
                  </p>
                  <h2 class="mt-1.5 text-lg font-extrabold tracking-[-0.02em] text-ink-950">
                    Hostinger vs {comparison.data.competitor}
                  </h2>
                </div>
                <span
                  class="shrink-0 rounded-lg bg-brand-50 px-2.5 py-1.5 text-[0.6875rem] font-bold text-brand-700"
                >
                  {comparison.data.winner}
                </span>
              </div>

              <p class="mt-3 flex-1 text-[0.875rem] leading-relaxed text-ink-600">
                {comparison.data.verdict.replace(/\s+/g, ' ').trim()}
              </p>

              <div class="mt-4 grid grid-cols-3 gap-2 border-t border-line pt-4 text-center">
                <div>
                  <p class="text-lg font-extrabold text-brand-700">{hostingerWins}</p>
                  <p class="text-[0.625rem] font-semibold text-ink-500">Hostinger</p>
                </div>
                <div>
                  <p class="text-lg font-extrabold text-ink-400">
                    {comparison.data.rows.length - hostingerWins - competitorWins}
                  </p>
                  <p class="text-[0.625rem] font-semibold text-ink-500">Tie</p>
                </div>
                <div>
                  <p class="text-lg font-extrabold text-ink-700">{competitorWins}</p>
                  <p class="text-[0.625rem] font-semibold text-ink-500">
                    {comparison.data.competitor}
                  </p>
                </div>
              </div>

              <span class="mt-4 inline-flex items-center gap-1.5 text-[0.8125rem] font-bold text-brand-700">
                Read the full comparison
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" aria-hidden="true">
                  <path d="M3 8h9m0 0-3.5-3.5M12 8l-3.5 3.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </a>
          );
        })
      }
    </div>

    <div class="mt-12 rounded-3xl border border-line bg-white p-8 text-center">
      <SectionHeading
        eyebrow="Not sure where to start?"
        title="Compare the plans, not the brands"
        description="Brand-level comparisons matter less than what you actually get for the money. The pricing matrix puts every plan's specs and renewal rate side by side."
        align="center"
        class="mx-auto"
      />
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href="/pricing/" class="btn btn-primary btn-lg">Open the pricing matrix</a>
        <AffiliateButton
          placement="comparison-table"
          campaign="compare-index"
          label="See Hostinger's current price"
          size="lg"
          variant="outline"
        />
      </div>
    </div>
  </section>
</BaseLayout>
