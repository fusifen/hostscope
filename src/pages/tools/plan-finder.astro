---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PlanFinder from '../../components/PlanFinder.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import FAQ from '../../components/FAQ.astro';
import { SITE } from '../../consts';
import { breadcrumbSchema, faqSchema, graph, organizationSchema } from '../../lib/seo';

const plans = await getCollection('plans');

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Tools', href: '/tools/' },
  { name: 'Plan finder', href: '/tools/plan-finder/' },
];

const faqs = [
  {
    question: 'How does the plan finder decide?',
    answer:
      'It applies a small set of rules in order. A self-managed VPS is only recommended when you say you want root access or are building an app. Within managed hosting, your expected traffic and whether you are running a store push you up the tiers, and a "cheapest possible" answer keeps you on the lowest tier that still meets your needs. The reasoning is printed with the result so you can check it.',
  },
  {
    question: 'Why does it recommend the same plan so often?',
    answer:
      "Because Unlimited is genuinely the best value point in Hostinger's current lineup — one dollar a month more than Premium roughly doubles the CPU allocation, adds daily backups with one-click restore and includes a dedicated IP. When a cheaper plan is the better answer, the finder will say so.",
  },
  {
    question: 'Do you store my answers?',
    answer:
      'No. The whole quiz runs in your browser using data embedded in the page. Nothing is submitted anywhere and there is no email gate.',
  },
  {
    question: 'What if I disagree with the result?',
    answer:
      'You should feel free to. Every recommendation comes with two alternatives and their prices, and the full specification of every plan is on the pricing page so you can compare them yourself.',
  },
  {
    question: 'Is the recommendation affected by your affiliate links?',
    answer:
      'No. The scoring is fixed and published in the reasoning, and it recommends the cheapest suitable plan rather than the most expensive one. Affiliate commission rates do not vary enough between Hostinger tiers to make upselling worthwhile, and our pricing pages show the renewal cost of every tier regardless.',
  },
];

const schema = graph([
  organizationSchema(),
  breadcrumbSchema(breadcrumbs),
  {
    '@type': 'WebApplication',
    name: 'Hostinger Plan Finder',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web-based',
    url: `${SITE.url}/tools/plan-finder/`,
    description:
      'A four-question quiz that recommends the right Hostinger hosting plan and explains the reasoning.',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  faqSchema(faqs),
]);
---

<BaseLayout
  title="Hostinger Plan Finder: Which Plan Do You Need?"
  description="Answer four questions about your project, traffic and technical comfort, and get a Hostinger plan recommendation with the reasoning shown — plus two alternatives."
  canonical={`${SITE.url}/tools/plan-finder/`}
  schema={schema}
  keywords={['which hostinger plan', 'hostinger plan finder', 'best hostinger plan for me']}
>
  <header class="border-b border-line bg-white">
    <div class="container-page py-8 lg:py-10">
      <Breadcrumbs items={breadcrumbs} />
      <div class="mt-5 max-w-3xl">
        <p class="eyebrow">Four questions · twenty seconds</p>
        <h1 class="mt-3 text-[1.875rem] font-extrabold leading-[1.12] tracking-[-0.03em] sm:text-[2.5rem]">
          Which Hostinger plan do you actually need?
        </h1>
        <p class="mt-4 text-[1.0625rem] leading-relaxed text-ink-600">
          Hostinger sells ten plans across four product families, and the cheapest one is often the
          wrong one. Answer four questions and we will point you at the right tier — and show our
          reasoning so you can push back.
        </p>
      </div>
    </div>
  </header>

  <section class="container-page py-10 lg:py-12">
    <div class="rounded-2xl border border-line bg-white p-6 sm:p-8">
      <PlanFinder plans={plans} />
    </div>

    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {
        [
          {
            title: 'How we score',
            body: 'Rules are applied in priority order: technical requirement first, then traffic expectation, then budget sensitivity. The cheapest plan that satisfies all three wins.',
          },
          {
            title: 'Where the data comes from',
            body: `Specs and prices come from our content files, verified against hostinger.com on ${SITE.pricingVerified}. Nothing is estimated.`,
          },
          {
            title: 'What we do not ask',
            body: 'No email address, no account, no marketing consent. The quiz runs entirely in your browser and nothing is transmitted.',
          },
        ].map((item) => (
          <div class="rounded-2xl border border-line bg-white p-5">
            <h2 class="text-[0.9375rem] font-bold text-ink-900">{item.title}</h2>
            <p class="mt-2 text-[0.875rem] leading-relaxed text-ink-600">{item.body}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-12 max-w-3xl">
      <FAQ faqs={faqs} title="Plan finder questions" />
    </div>

    <div class="mt-10 rounded-2xl border border-brand-200 bg-gradient-to-br from-brand-50 to-white p-6 text-center">
      <SectionHeading
        eyebrow="Still comparing?"
        title="See every plan's specs side by side"
        description="The pricing matrix shows all ten plans with their intro price, renewal rate and full technical limits in one table."
        align="center"
        class="mx-auto"
      />
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href="/pricing/" class="btn btn-primary btn-lg">Open the pricing matrix</a>
        <a href="/tools/hosting-cost-calculator/" class="btn btn-outline btn-lg">
          Calculate the true cost
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
