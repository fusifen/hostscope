---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CostCalculator from '../../components/CostCalculator.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import FAQ from '../../components/FAQ.astro';
import { SITE } from '../../consts';
import { breadcrumbSchema, faqSchema, graph, organizationSchema } from '../../lib/seo';

const plans = (await getCollection('plans')).sort(
  (a, b) => a.data.pricing.promoMonthly - b.data.pricing.promoMonthly,
);

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Tools', href: '/tools/' },
  { name: 'Cost calculator', href: '/tools/hosting-cost-calculator/' },
];

const faqs = [
  {
    question: 'Why does the calculator use the renewal price?',
    answer:
      'Because the intro rate only applies for the length of the term you buy. If you take a 48-month plan and keep the site for six years, you spend four years at the intro rate and two years at the renewal rate. Ignoring the renewal rate makes every host look cheaper than it is.',
  },
  {
    question: 'Does this include taxes?',
    answer:
      'No. Hostinger quotes prices excluding applicable taxes, and tax depends on your billing country. Add your local rate to the totals if you need a fully loaded figure.',
  },
  {
    question: 'What about add-ons and the domain after year one?',
    answer:
      'Also excluded. The free domain is only free for the first 12 months; after that it renews at the standard rate for the extension, typically around $9.99–$15.99/yr for a .com. Optional add-ons sold at checkout are not included either.',
  },
  {
    question: 'Should I use the four-year or six-year view?',
    answer:
      'Use whichever matches how long you expect to keep the project. Four years is the honest comparison point for most people, because it is the length of the intro term. The six-year view is useful for seeing how much of your total spend ends up at the renewal rate.',
  },
  {
    question: 'Can I get a better blended rate than this?',
    answer:
      'Yes, in three ways: buy the longest term you are confident about so the intro rate lasts longer, upgrade in place rather than buying a second plan, and decide before renewal whether the new price is still worth paying — migrating at renewal is often cheaper than accepting a large increase.',
  },
];

const schema = graph([
  organizationSchema(),
  breadcrumbSchema(breadcrumbs),
  {
    '@type': 'WebApplication',
    name: 'Hostinger True Cost Calculator',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Web-based',
    url: `${SITE.url}/tools/hosting-cost-calculator/`,
    description:
      'Calculate the real long-term cost of Hostinger plans by applying the intro rate for the intro term and the renewal rate afterwards.',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  faqSchema(faqs),
]);
---

<BaseLayout
  title="Hostinger True Cost Calculator: What You Really Pay"
  description="Hosting ads quote the intro rate. This calculator applies the renewal rate too, so you can see what a Hostinger plan actually costs over one, two, four or six years."
  canonical={`${SITE.url}/tools/hosting-cost-calculator/`}
  schema={schema}
  keywords={['hostinger cost calculator', 'hostinger total cost', 'hostinger renewal cost']}
>
  <header class="border-b border-line bg-white">
    <div class="container-page py-8 lg:py-10">
      <Breadcrumbs items={breadcrumbs} />
      <div class="mt-5 max-w-3xl">
        <p class="eyebrow">Free · runs in your browser</p>
        <h1 class="mt-3 text-[1.875rem] font-extrabold leading-[1.12] tracking-[-0.03em] sm:text-[2.5rem]">
          What a Hostinger plan actually costs you
        </h1>
        <p class="mt-4 text-[1.0625rem] leading-relaxed text-ink-600">
          Every hosting company advertises the introductory rate and bills the renewal rate. This
          calculator applies both, over the period you actually plan to keep the site, and shows how
          much of your total spend ends up at the higher price.
        </p>
      </div>
    </div>
  </header>

  <section class="container-page py-10 lg:py-12">
    <div class="rounded-2xl border border-line bg-white p-6 sm:p-8">
      <CostCalculator plans={plans} />
    </div>

    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {
        [
          {
            title: 'Intro rate',
            body: 'The promotional monthly price, applied for the length of the term you buy. This is the number on the sales page.',
          },
          {
            title: 'Renewal rate',
            body: 'The price after the intro term ends. Premium goes to $10.99/mo, Unlimited to $16.99/mo and Cloud Startup to $25.99/mo.',
          },
          {
            title: 'Blended rate',
            body: 'Total spend divided by the number of months. This is the fair number to compare against any other host.',
          },
        ].map((item) => (
          <div class="rounded-2xl border border-line bg-white p-5">
            <h2 class="text-[0.9375rem] font-bold text-ink-900">{item.title}</h2>
            <p class="mt-2 text-[0.875rem] leading-relaxed text-ink-600">{item.body}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-12 rounded-2xl border border-sun-200 bg-sun-50 p-6">
      <h2 class="text-[1rem] font-bold text-sun-700">What this calculator does not include</h2>
      <ul class="mt-3 grid gap-2 sm:grid-cols-2">
        {
          [
            'Applicable taxes, which vary by billing country',
            'Domain renewal after the free first year',
            'Optional add-ons purchased at checkout',
            'Third-party services such as premium plugins or CDNs',
            'Price changes Hostinger makes to renewal rates in future',
          ].map((item) => (
            <li class="flex gap-2.5 text-[0.875rem] leading-relaxed text-sun-700">
              <span class="mt-[0.45rem] h-1.5 w-1.5 shrink-0 rounded-full bg-sun-500" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-4 text-[0.8125rem] leading-relaxed text-sun-700">
        Prices verified against hostinger.com on {SITE.pricingVerified}. Hostinger changes
        promotional pricing without notice — the checkout page is always the final word.
      </p>
    </div>

    <div class="mt-12 max-w-3xl">
      <FAQ faqs={faqs} title="Cost calculator questions" />
    </div>

    <div class="mt-10 rounded-2xl border border-brand-200 bg-gradient-to-br from-brand-50 to-white p-6 text-center">
      <SectionHeading
        eyebrow="Next step"
        title="Not sure which plan to put in the calculator?"
        description="The plan finder narrows ten plans down to one in about twenty seconds, and shows its reasoning."
        align="center"
        class="mx-auto"
      />
      <a href="/tools/plan-finder/" class="btn btn-primary btn-lg mt-6">Open the plan finder</a>
    </div>
  </section>
</BaseLayout>
