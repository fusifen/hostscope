---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { SITE } from '../../consts';
import { breadcrumbSchema, graph, organizationSchema } from '../../lib/seo';

const plans = await getCollection('plans');

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Tools', href: '/tools/' },
];

const schema = graph([
  organizationSchema(),
  breadcrumbSchema(breadcrumbs),
  {
    '@type': 'CollectionPage',
    name: 'Hostinger tools and calculators',
    url: `${SITE.url}/tools/`,
    isPartOf: { '@id': `${SITE.url}/#website` },
  },
]);

const tools = [
  {
    href: '/tools/plan-finder/',
    title: 'Hostinger plan finder',
    summary: 'Four questions, twenty seconds, one recommendation.',
    body: 'Tell us what you are building, how much traffic you expect, how hands-on you want to be and what matters most on price. The finder scores all ten Hostinger plans and shows you the reasoning, plus two alternatives in case you disagree.',
    bullets: [
      'Covers web, cloud, VPS and Website Builder plans',
      'Shows the reasoning, not just a result',
      'Includes runner-up options and their prices',
      'No email address required',
    ],
  },
  {
    href: '/tools/hosting-cost-calculator/',
    title: 'True cost calculator',
    summary: 'What you actually pay across one to six years.',
    body: 'The advertised monthly price only applies for the length of the intro term. This calculator applies the intro rate for that term and the renewal rate after it, then shows the blended monthly cost — the number to compare against any other host.',
    bullets: [
      'Compare up to ten plans side by side',
      'Horizons of one, two, four or six years',
      'Separates intro spend from renewal spend',
      'Highlights how much of the total is paid at the higher rate',
    ],
  },
];

const upcoming = [
  {
    title: 'Renewal price checker',
    body: 'Enter the date you bought and we work out exactly when your rate changes and what it changes to.',
  },
  {
    title: 'Plan upgrade advisor',
    body: 'Tell it your current plan and symptoms, and it maps the symptom to the resource limit you have hit.',
  },
];
---

<BaseLayout
  title="Hostinger Tools: Plan Finder and True Cost Calculator"
  description="Two free Hostinger tools: a four-question plan finder that explains its reasoning, and a cost calculator that applies the renewal rate so you see the real price."
  canonical={`${SITE.url}/tools/`}
  schema={schema}
  keywords={['hostinger plan finder', 'hostinger cost calculator', 'which hostinger plan']}
>
  <header class="border-b border-line bg-white">
    <div class="container-page py-8 lg:py-10">
      <Breadcrumbs items={breadcrumbs} />
      <div class="mt-5 max-w-3xl">
        <p class="eyebrow">Free · no signup</p>
        <h1 class="mt-3 text-[1.875rem] font-extrabold leading-[1.12] tracking-[-0.03em] sm:text-[2.5rem]">
          Work out the numbers before you buy
        </h1>
        <p class="mt-4 text-[1.0625rem] leading-relaxed text-ink-600">
          Both tools run entirely in your browser using the same verified pricing data that powers
          our pricing matrix. No account, no email, no data leaves the page.
        </p>
      </div>
    </div>
  </header>

  <section class="container-page py-10 lg:py-14">
    <div class="grid gap-6 lg:grid-cols-2">
      {
        tools.map((tool) => (
          <a href={tool.href} class="card card-hover group flex flex-col p-6" data-reveal>
            <p class="text-[0.6875rem] font-bold tracking-[0.08em] text-brand-700 uppercase">
              Interactive tool
            </p>
            <h2 class="mt-2 text-xl font-extrabold tracking-[-0.02em] text-ink-950">
              {tool.title}
            </h2>
            <p class="mt-1.5 text-[0.9375rem] font-semibold text-ink-600">{tool.summary}</p>
            <p class="mt-3 flex-1 text-[0.875rem] leading-relaxed text-ink-600">{tool.body}</p>
            <ul class="mt-4 space-y-2 border-t border-line pt-4">
              {tool.bullets.map((bullet) => (
                <li class="flex gap-2.5 text-[0.8125rem] leading-snug text-ink-600">
                  <svg
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.4"
                    class="mt-1 h-3 w-3 shrink-0 text-mint-600"
                    aria-hidden="true"
                  >
                    <path d="m3.5 8.5 3 3 6-7" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
            <span class="mt-5 inline-flex items-center gap-1.5 text-[0.875rem] font-bold text-brand-700">
              Open {tool.title}
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" aria-hidden="true">
                <path d="M3 8h9m0 0-3.5-3.5M12 8l-3.5 3.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </a>
        ))
      }
    </div>

    <div class="mt-14">
      <SectionHeading
        eyebrow="On the roadmap"
        title="Tools we are still building"
        description="If one of these would be useful to you, the underlying data is already published on the pricing page."
      />
      <div class="mt-6 grid gap-5 md:grid-cols-2">
        {
          upcoming.map((item) => (
            <div class="rounded-2xl border border-dashed border-line-strong bg-white/60 p-5">
              <p class="pill pill-ink">Coming soon</p>
              <h3 class="mt-3 text-[1rem] font-bold text-ink-800">{item.title}</h3>
              <p class="mt-2 text-[0.875rem] leading-relaxed text-ink-500">{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-12 rounded-2xl border border-line bg-white p-6">
      <h2 class="text-[0.9375rem] font-bold text-ink-900">Where the data comes from</h2>
      <p class="mt-2 text-[0.875rem] leading-relaxed text-ink-600">
        Prices, term lengths and renewal rates are read from the same content files that power our
        pricing matrix and plan reviews, and each one records the date it was last checked against
        hostinger.com. Current verification date:{' '}
        <strong class="font-semibold text-ink-800">{SITE.pricingVerified}</strong>. Specs come from
        Hostinger's own published parameters table rather than its marketing pages, which is why some
        numbers here differ from what you see on a landing page — the most notable being the 100-site
        technical cap on cloud plans that is marketed as unlimited.
      </p>
      <p class="mt-3 text-[0.8125rem] text-ink-500">
        {plans.length} plans in the dataset.
      </p>
    </div>
  </section>
</BaseLayout>
