---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyOfferBar from '../components/StickyOfferBar.astro';

export interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  schema?: object | object[];
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  keywords?: string[];
  /** Suppress the floating offer bar on pages that are already CTA-heavy. */
  hideStickyBar?: boolean;
  bodyClass?: string;
  /** Remove the default top padding for full-bleed hero pages. */
  bare?: boolean;
}

const {
  hideStickyBar = false,
  bodyClass = '',
  bare = false,
  ...head
} = Astro.props;
---

<!doctype html>
<html lang="en" class="no-js scroll-smooth">
  <head>
    <BaseHead {...head} />
  </head>
  <body class={`min-h-dvh bg-canvas antialiased ${bodyClass}`}>
    <a
      href="#main"
      class="sr-only-focusable absolute left-4 top-4 z-[100] rounded-lg bg-ink-950 px-4 py-2 text-sm font-semibold text-white"
    >
      Skip to main content
    </a>

    <Header />

    <main id="main" class={bare ? '' : 'pb-8'}>
      <slot />
    </main>

    <Footer />

    {!hideStickyBar && <StickyOfferBar />}

    <script>
      import '../scripts/animations';
    </script>
  </body>
</html>
